# ==============================================================================
# EMPEROR SAAS PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# إمبراطور للشحن الرقمي والبطاقات وبيع التارجت
# ==============================================================================

APP_NAME="Emperor"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL=https://emperor.vip
FRONTEND_URL=https://emperor.vip
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emperor_prod
DB_USERNAME=emperor_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_STRICT_MODE=true

# ------------------------------------------------------------------------------
# DRIVERS (REDIS RECOMMENDED FOR HIGH PERFORMANCE)
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.emperor.vip
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=emperor_cache_

MEMCACHED_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# MAIL CONFIGURATION (SMTP / Postmark / Resend / Mailgun)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@emperor.vip
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@emperor.vip"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# GOOGLE OAUTH
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# ------------------------------------------------------------------------------
# FIREBASE FCM & PHONE AUTH
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=emperor-saas-prod
FIREBASE_SERVER_KEY=YOUR_FIREBASE_CLOUD_MESSAGING_SERVER_KEY
FIREBASE_CREDENTIALS_PATH=storage/app/firebase/firebase_credentials.json

# ------------------------------------------------------------------------------
# WHATSAPP NOTIFICATIONS (Meta Cloud API / UltraMsg)
# ------------------------------------------------------------------------------
WHATSAPP_DRIVER=meta
# Meta Cloud API
META_WHATSAPP_TOKEN=YOUR_META_WHATSAPP_PERMANENT_ACCESS_TOKEN
META_WHATSAPP_PHONE_ID=YOUR_META_PHONE_NUMBER_ID
# UltraMsg Fallback
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=YOUR_ULTRAMSG_TOKEN

# ------------------------------------------------------------------------------
# REAL GAME & VOUCHER PROVIDERS
# ------------------------------------------------------------------------------
# Hala Provider
HALA_API_URL=https://api.hala-topup.com/v1
HALA_API_KEY=YOUR_HALA_API_KEY
HALA_API_SECRET=YOUR_HALA_API_SECRET
HALA_SANDBOX_MODE=false

# Tami Provider
TAMI_API_URL=https://api.tami-cards.com/api/v2
TAMI_CLIENT_ID=YOUR_TAMI_CLIENT_ID
TAMI_CLIENT_SECRET=YOUR_TAMI_CLIENT_SECRET
TAMI_SANDBOX_MODE=false

# ------------------------------------------------------------------------------
# REVERB WEBSOCKET (REAL-TIME NOTIFICATIONS & STATUS)
# ------------------------------------------------------------------------------
REVERB_APP_ID=emperor_app_id
REVERB_APP_KEY=emperor_app_key_prod
REVERB_APP_SECRET=emperor_app_secret_prod
REVERB_HOST="ws.emperor.vip"
REVERB_PORT=443
REVERB_SCHEME=https

# ------------------------------------------------------------------------------
# VITE FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}/api/v1"
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=emperor-saas-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=emperor-saas-prod
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
VITE_FIREBASE_VAPID_KEY=BMk...
